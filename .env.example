# Copie este arquivo para ".env" e preencha. O arquivo .env não vai para o GitHub.

# Opção gratuita: Gemini (Google). Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY= COLAR A CHAVE
# Se o Gemini disser que não achou o modelo, troque por outro que apareça no AI Studio:
# GEMINI_MODEL=gemini-3.1-flash-lite

# Opção paga: Claude (Anthropic), em https://console.anthropic.com
# ANTHROPIC_API_KEY=cole-sua-chave-aqui
# CLAUDE_MODEL=claude-haiku-5-5

# Qual usar quando as duas chaves existem: gemini ou anthropic (vazio = Gemini primeiro)
# IA_PROVEDOR=gemini

# Máximo de usos da IA por pessoa por hora (padrão 30)
# IA_LIMITE_POR_HORA=30
